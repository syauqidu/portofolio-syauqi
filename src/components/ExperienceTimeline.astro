---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { experiences } from '../data/experience';
// Drop an official logo into public/images/organizations/<id>/logo.png (or svg/webp/jpg).
const logoFor = (id: string) => ['svg', 'webp', 'png', 'jpg'].map(ext => `/images/organizations/${id}/logo.${ext}`).find(path => existsSync(resolve('public', path.slice(1))));
---
<section id="experience" class="section section-bordered home-band">
  <div class="shell">
    <SectionHeading number="03" label="Experience" title="Where I’ve contributed." />
    <p class="journey-note">Professional, academic, and project experience, from most recent to earliest. Some roles overlap.</p>
    <experience-timeline>
      <div class="journey-track" aria-hidden="true">
        <span class="journey-fill"></span>
        <span class="journey-marker"><Icon name="lucide:train-front" size={19} /></span>
      </div>
      <ol class="journey-entries" aria-label="Professional and academic experience">
        {experiences.map((experience) => (
          <li class="journey-entry">
            <span class="journey-stop" aria-hidden="true"></span>
            <div class="experience-identity">
              <span class="experience-logo" aria-hidden="true">
                {logoFor(experience.logo) ? <img src={logoFor(experience.logo)} alt="" width="64" height="64" loading="lazy" /> : <span>{experience.initials}</span>}
              </span>
              {experience.period && <p class="experience-date">{experience.period}</p>}
            </div>
            <div class="journey-content">
              <h3>{experience.role}</h3>
              <p class="organization">{experience.organization}</p>
              <p>{experience.focus}</p>
              {experience.subjects && <ul class="experience-subjects">{experience.subjects.map(subject => <li>{subject}</li>)}</ul>}
              {experience.project && <a class="text-link" href={experience.project}>View case study <span aria-hidden="true">↗</span></a>}
            </div>
            <span class="experience-type">{experience.type}</span>
          </li>
        ))}
      </ol>
    </experience-timeline>
  </div>
</section>
<script>
  import { getScrollProgress, getTimelineBounds } from '../lib/scroll-progress';

  class ExperienceTimeline extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      if (this.dispose) return;
      const section = this.closest<HTMLElement>('section');
      const track = this.querySelector<HTMLElement>('.journey-track');
      const entries = Array.from(this.querySelectorAll<HTMLElement>('.journey-entry'));
      const stops = Array.from(this.querySelectorAll<HTMLElement>('.journey-stop'));
      if (!section || !track || stops.length < 2 || !('IntersectionObserver' in window) || !('ResizeObserver' in window)) return;

      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const header = document.querySelector<HTMLElement>('.site-header');
      const events = new AbortController();
      let frame = 0;
      let geometryDirty = true;
      let disposed = false;
      let visible = false;
      let listening = false;
      let start = 0;
      let end = 0;
      let travel = 0;
      let stopOffsets: number[] = [];

      const reset = () => {
        delete this.dataset.animated;
        entries.forEach((entry) => {
          delete entry.dataset.reached;
          delete entry.dataset.current;
        });
      };

      const measure = () => {
        // Read layout together before changing styles. The marker and line share this geometry.
        const rootTop = this.getBoundingClientRect().top;
        const points = stops.map((stop) => {
          const rect = stop.getBoundingClientRect();
          return rect.top + rect.height / 2;
        });
        const first = points[0];
        const last = Math.max(points[points.length - 1], entries[entries.length - 1].getBoundingClientRect().bottom - 24);
        // Match one document pixel of scrolling to one pixel on the rail.
        // Stay at the viewport midpoint until the final entry's content has passed it.
        const bounds = getTimelineBounds(first + window.scrollY, last + window.scrollY, window.innerHeight);
        start = bounds.start;
        end = bounds.end;
        travel = Math.max(0, last - first);
        stopOffsets = points.map((point) => point - first);
        track.style.top = `${first - rootTop}px`;
        track.style.height = `${travel}px`;
        geometryDirty = false;
      };

      const update = () => {
        frame = 0;
        if (disposed || motion.matches) return;
        try {
          if (geometryDirty) measure();
          const progress = getScrollProgress(window.scrollY, start, end);
          const offset = progress * travel;
          this.style.setProperty('--journey-progress', String(progress));
          this.style.setProperty('--journey-offset', `${offset}px`);
          let current = -1;
          entries.forEach((entry, index) => {
            const reached = window.scrollY >= start && offset + 0.5 >= stopOffsets[index];
            entry.dataset.reached = String(reached);
            if (reached) current = index;
          });
          entries.forEach((entry, index) => { entry.dataset.current = String(index === current); });
          this.dataset.animated = 'true';
        } catch {
          // Progressive enhancement must never make the experience content unavailable.
          cleanup();
        }
      };
      const schedule = () => {
        if (!disposed && !motion.matches && !frame) frame = requestAnimationFrame(update);
      };
      const invalidate = () => { geometryDirty = true; schedule(); };
      const syncListening = () => {
        const wanted = visible && !motion.matches && !disposed;
        if (wanted && !listening) window.addEventListener('scroll', schedule, { passive: true });
        if (!wanted && listening) window.removeEventListener('scroll', schedule);
        listening = wanted;
      };
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        syncListening();
        // Update on exit as well, including scroll jumps past the whole section.
        invalidate();
      });
      const resize = new ResizeObserver(invalidate);
      const cleanup = () => {
        disposed = true;
        cancelAnimationFrame(frame);
        window.removeEventListener('scroll', schedule);
        observer.disconnect();
        resize.disconnect();
        events.abort();
        reset();
      };
      this.dispose = cleanup;
      motion.addEventListener('change', () => {
        cancelAnimationFrame(frame);
        frame = 0;
        reset();
        syncListening();
        invalidate();
      }, { signal: events.signal });
      window.addEventListener('resize', invalidate, { passive: true, signal: events.signal });
      window.addEventListener('pageshow', invalidate, { signal: events.signal });
      window.addEventListener('load', invalidate, { once: true, signal: events.signal });
      document.addEventListener('visibilitychange', invalidate, { signal: events.signal });
      observer.observe(section);
      resize.observe(section);
      if (header) resize.observe(header);
      document.fonts.ready.then(invalidate);
      // Set the actual state immediately, including hash links and restored scroll positions.
      update();
    }

    disconnectedCallback() {
      this.dispose?.();
      this.dispose = undefined;
    }
  }
  if (!customElements.get('experience-timeline')) customElements.define('experience-timeline', ExperienceTimeline);
</script>
